# Copy this file to .env and fill in your keys.

# https://api-dashboard.search.brave.com (free tier: ~2,000 searches/month)
BRAVE_API_KEY=

# https://console.anthropic.com - leave blank to use the free rules-only mode
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# PREFILTER=on
# PREFILTER_MODEL=claude-haiku-4-5

# https://api.data.gov/signup - free, used for US enrollment and tuition
SCORECARD_API_KEY=

# Google: put the OAuth client file you downloaded at ./credentials.json
# GOOGLE_OAUTH_CLIENT=credentials.json
# Leave blank and the tool creates a new sheet the first time it syncs
GOOGLE_SHEET_ID=

GMAIL_SENDER=javon@naturl.audio
SENDER_NAME=Javon

# Optional tuning
# MIN_RELEVANCE=3
# MAX_PAGES_PER_SCHOOL=8
# CRAWL_DELAY_SECONDS=1.0
